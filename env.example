# Copy this file to ".env" and fill it in. NEVER commit ".env".

# Required in production. Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Free key from https://api.nasa.gov (DEMO_KEY works but is rate-limited)
NASA_API_KEY=DEMO_KEY

# Real AI for NOVA (https://console.anthropic.com). Leave empty to keep NOVA in demo mode.
ANTHROPIC_API_KEY=
NOVA_MODEL=claude-sonnet-5-5

# Optional: where the SQLite database lives (use a persistent disk in production)
# DATABASE_PATH=/var/data/auth.db

# Optional: only needed if the website is hosted on a different domain than this server
# CORS_ORIGINS=https://your-site.netlify.app
